{
  "compilerOptions": {
    /* Language & environment */
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /* Module resolution */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Output — Vite handles emit, TS only type-checks */
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* Path aliases — mirrors vite.config */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "electron"],
  "exclude": ["node_modules", "dist", "windows-build", "android", "ios"]
}